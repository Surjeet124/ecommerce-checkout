PORT=4242
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/ecommerce?retryWrites=true&w=majority

# Any long random string; used to sign login tokens
JWT_SECRET=replace_this_with_a_long_random_string

# Frontend URL(s) allowed to call this API (comma-separated)
CLIENT_URL=http://localhost:5173

# Razorpay TEST keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Used only by `npm run seed` to create the first admin account
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password
